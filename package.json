{
  "name": "spotify-extension",
  "version": "0.0.1",
  "description": "Themes, extensions and tweaks for the Spotify desktop client.",
  "author": {
    "name": "ninokiru",
    "url": "https://github.com/ninokiru"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:payload": "esbuild src/payload/bootstrap.ts --bundle --outfile=dist/payload/runtime.js --format=iife --target=chrome130 --minify",
    "build": "npm run typecheck && npm run build:payload"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
