{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotify Extension",
  "version": "0.0.1",
  "identifier": "com.ninokiru.spotifyextension",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spotify Extension",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
